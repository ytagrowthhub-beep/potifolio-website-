# Site
NEXT_PUBLIC_SITE_URL=https://ayorfetech.com

# GitHub portfolio sync (public repos; token optional for higher API limits)
GITHUB_USERNAME=ytagrowthhub-beep
# Create at https://github.com/settings/tokens (classic) — no scopes required for public repos
# Or use a fine-grained token with Contents: Read on your public repos
GITHUB_TOKEN=ghp_your_personal_access_token
# GITHUB_EXCLUDE_REPOS=my-portfolio-websiite,private-draft
# Hide from home featured section only (comma-separated repo names)
# FEATURED_EXCLUDE_REPOS=young-wears
# FEATURED_PINNED_REPOS=pockect-sms,paultecnology-potifolio

# Pocket SMS live demo:
POCKECT_SMS_LIVE_URL=https://pocket-sms-link.vercel.app/

# Live URL for Young Wears (if not set on GitHub repo Website field)
# YOUNG_WEARS_LIVE_URL=https://your-young-wears-domain.vercel.app
# Live URL for Paultecnology (overrides stale GitHub homepage if needed)
# PAULTECNOLOGY_LIVE_URL=https://paultecnology.com
# Or JSON map: GITHUB_PROJECT_LIVE_URLS={"young-wears":"https://your-site.com","pockect-sms":"https://your-pocket-sms.vercel.app"}

# Database (optional — projects now sync from GitHub)
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
